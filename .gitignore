*.bak
*.bak-*
*.zip
*.log
.tmp/
.DS_Store
Thumbs.db

# Build del front (se genera en el Dockerfile o con npm run build:web)
dist/

# Binario de la app Android (se genera con quanto-android/build.sh)
public/downloads/*.apk
