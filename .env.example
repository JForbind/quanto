# ------------------------------------------------------------------
#  Quanto 2.0 — configuración
#  Copia este archivo a ".env" y rellena lo que necesites:
#      cp .env.example .env
# ------------------------------------------------------------------

# Puerto en el que se publica la app en tu red (el interno siempre es 8765).
# Por defecto 8766 para poder convivir con la app anterior en el 8765.
QUANTO_PORT=8766

# Contraseña para entrar. Si la dejas vacía, Quanto genera una
# aleatoria y la escribe en el log la primera vez.
APP_PASSWORD=

# Cada cuántos minutos se guarda un punto del histórico del valor
SNAP_INTERVAL_MIN=5

# Días que dura la sesión iniciada
SESSION_DAYS=30

# Zona horaria del contenedor
TZ=Europe/Madrid

# ------------------------------------------------------------------
#  OPCIONAL
# ------------------------------------------------------------------
# Puedes pegar las claves de Bitvavo en la propia interfaz
# (Ajustes → Bitvavo). Si prefieres hacerlo aquí, descomenta:
#
# BITVAVO_API_KEY=
# BITVAVO_API_SECRET=
#
# Secreto para firmar la cookie de sesión. Si no lo pones, Quanto
# genera uno y lo guarda en data/session-secret.txt.
#
# COOKIE_SECRET=
